DATABASE_URL="postgresql://usuario:password@localhost:5432/pos"
# Clave de instalación: solo para crear la cuenta del dueño de un restaurante sin cuentas
ADMIN_PASSWORD="cambia-esto"
SESSION_SECRET="una-cadena-larga-y-aleatoria"
TZ="America/Tegucigalpa"

# Varios restaurantes: cada uno entra por <slug>.ROOT_DOMAIN
ROOT_DOMAIN=""
# Única dirección donde abre /plataforma (si no, cualquiera sin subdominio de restaurante)
PLATFORM_HOST=""
# Restaurante que abre la dirección sin subdominio (por defecto, el primero)
DEFAULT_RESTAURANT=""

# Pago de la suscripción con tarjeta (Pagadito vía IMZA Pagos). Sin las dos, no se ofrece.
# En imzaris.com: PRODUCTO_RISTEMO_SECRETO (el mismo secreto), PRODUCTO_RISTEMO_ORIGENES (https://*.ROOT_DOMAIN)
# y PRODUCTO_RISTEMO_WEBHOOK=https://<dominio principal>/api/imza-pagos/webhook
IMZA_PAGOS_URL=""
IMZA_PAGOS_SECRETO=""

# Se incrustan al compilar (en Coolify: Build Variable)
# Fotos de productos en un almacenamiento S3 (MinIO, R2…). Sin esto se guardan en ./uploads (UPLOAD_DIR)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

NEXT_PUBLIC_BUSINESS_NAME="Mi Restaurante"
NEXT_PUBLIC_BUSINESS_ADDRESS="Dirección del local"
NEXT_PUBLIC_BUSINESS_TAX_ID=""
NEXT_PUBLIC_CURRENCY_SYMBOL="L"
NEXT_PUBLIC_LOCALE="es-HN"
