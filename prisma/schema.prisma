generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Nuestras tablas

// Salas del local (Salón principal, Terraza…)
model Area {
  id        Int      @id @default(autoincrement())
  name      String
  position  Int      @default(0)
  tables    Table[]
  createdAt DateTime @default(now())
}

model Table {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  status    String   @default("FREE") // FREE o OCCUPIED
  orders    Order[]

  // Plano: sala, forma, puestos y posición en la cuadrícula (null = acomodo automático)
  areaId    Int?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  shape     String   @default("square") // square | round | rect
  seats     Int      @default(4)
  x         Int?
  y         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  kitchen  Boolean   @default(true) // Sus productos se envían a la pantalla de cocina
  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  
  // Relación con la tabla Category
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id])
  
  orderItems   OrderItem[]
  kitchenItems KitchenItem[]
  createdAt    DateTime    @default(now())
}

model Order {
  id        Int         @id @default(autoincrement())
  tableId   Int
  table     Table       @relation(fields: [tableId], references: [id])
  status    String      @default("OPEN") // OPEN o PAID
  items     OrderItem[]
  payments  Payment[]   // Para dividir la cuenta
  kitchenItems KitchenItem[]
  // --- NUEVO: Relación con el Mesero ---
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id])
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float    // Precio guardado al momento de la venta
}

// Lo que la cocina tiene que preparar. Va aparte de OrderItem para que cobrar
// (que descuenta líneas de la cuenta) no borre pedidos que aún se están cocinando.
model KitchenItem {
  id        Int       @id @default(autoincrement())
  orderId   Int
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Int       @default(1)
  status    String    @default("PENDING") // PENDING → READY → SERVED
  createdAt DateTime  @default(now())
  readyAt   DateTime?

  @@index([status])
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Float    // Monto para dividir cuenta
  method    String   // CASH, CARD, etc.
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  pin       String   @unique // El PIN de 4 dígitos para que el mesero entre
  role      String   @default("WAITER") // WAITER o ADMIN
  orders    Order[]
  createdAt DateTime @default(now())
}