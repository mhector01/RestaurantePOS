generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Nuestras tablas

model Table {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  status    String   @default("FREE") // FREE o OCCUPIED
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  price       Float
  
  // Relación con la tabla Category
  categoryId Int
  category   Category    @relation(fields: [categoryId], references: [id])
  
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Order {
  id        Int         @id @default(autoincrement())
  tableId   Int
  table     Table       @relation(fields: [tableId], references: [id])
  status    String      @default("OPEN") // OPEN o PAID
  items     OrderItem[]
  payments  Payment[]   // Para dividir la cuenta
  // --- NUEVO: Relación con el Mesero ---
  userId    Int?
  user      User?       @relation(fields: [userId], references: [id])
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float    // Precio guardado al momento de la venta
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Float    // Monto para dividir cuenta
  method    String   // CASH, CARD, etc.
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  pin       String   @unique // El PIN de 4 dígitos para que el mesero entre
  role      String   @default("WAITER") // WAITER o ADMIN
  orders    Order[]
  createdAt DateTime @default(now())
}